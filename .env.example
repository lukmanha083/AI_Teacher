# AI Teacher POC Configuration

# LLM Server Configuration
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_API_KEY=your-secret-api-key-here

# Model Configuration
MODEL_NAME=lfm2-7b-q8
MODEL_PATH=./data/models/lfm2-7b-q8_0.gguf
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768

# Database Paths (POC - DuckDB)
DUCKDB_PATH=./data/databases/ai_teacher.duckdb

# Neo4j Configuration (POC)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# PostgreSQL (Future - not used in POC)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=ai_teacher
# POSTGRES_USER=ai_teacher
# POSTGRES_PASSWORD=your-postgres-password

# Redis (Future - not used in POC)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# RAG Configuration
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.7

# LLM Generation Settings
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
CONTEXT_WINDOW=4096

# Memory Settings
CONVERSATION_BUFFER_SIZE=10
ENABLE_ADAPTIVE_LEARNING=True

# Paths
TEXTBOOK_DIR=./data/textbooks
EMBEDDING_CACHE_DIR=./data/embeddings
LOG_DIR=./logs

# API Server (Future)
# API_HOST=0.0.0.0
# API_PORT=8000
# API_WORKERS=4
