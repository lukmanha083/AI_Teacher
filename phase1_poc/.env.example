# Phase 1 POC Configuration
# Copy this file to .env and adjust values

# CozoDB Configuration
COZODB_ENGINE=sqlite
COZODB_PATH=./data/ai_teacher.db

# LLM Configuration (llama.cpp - for answer generation)
MODEL_PATH=./models/lfm2-7b-q8_0.gguf
MODEL_CONTEXT_SIZE=4096
MODEL_THREADS=4
MODEL_GPU_LAYERS=0
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_API_KEY=

# Grok API Configuration (for TypeAgent entity extraction)
# Get your API key from: https://console.x.ai/
GROK_API_KEY=your-grok-api-key-here
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-1212
# Cost: $2/1M input tokens, $10/1M output tokens
# Estimated: $0.002 per query for entity extraction

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768

# HNSW Index Configuration
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_DISTANCE=Cosine

# TypeAgent Structured RAG Configuration
ENABLE_TYPEAGENT=true
# Entity extraction temperature (lower = more conservative)
ENTITY_EXTRACTION_TEMPERATURE=0.3
# Maximum entities to extract per query
MAX_ENTITIES_PER_QUERY=10
# Hybrid search: combine entity matching + vector similarity
HYBRID_SEARCH_ENTITY_WEIGHT=0.6
HYBRID_SEARCH_VECTOR_WEIGHT=0.4
